# update-2023-5.ps1 - Populates official Reading (A-H) and Writing data for exam session 2023-5

Write-Host "Populating Reading and Writing data for 2023-5..." -ForegroundColor Cyan

$examDir = "data/sfi/2023-5"
$readingDir = Join-Path $examDir "reading"
$writingDir = Join-Path $examDir "writing"

New-Item -ItemType Directory -Path $readingDir -Force | Out-Null
New-Item -ItemType Directory -Path $writingDir -Force | Out-Null

# ==========================================
# 1. READING CONFIG & SECTIONS (A - H)
# ==========================================

$configJson = @'
{
  "year": "2023-5",
  "module": "reading",
  "title": "SFI Läsförståelse – Exam 2023-5",
  "passThreshold": 0.6,
  "sections": ["A.json", "B.json", "C.json", "D.json", "E.json", "F.json", "G.json", "H.json"]
}
'@
Set-Content -Path "$readingDir/config.json" -Value $configJson -Encoding utf8

# Section A: Information om en festival
$secA = @'
{
  "section": "A",
  "icon": "🎪",
  "title": "Information om en festival",
  "instructions": "Läs informationen om festivalen i Lövby kommun och svara på frågorna.",
  "texts": [
    {
      "heading": "Festivalen i Lövby",
      "body": "Välkommen till Lövby-festivalen! Här är några höjdpunkter från programmet:\n\n• På Stora torget på kvällen spelar och sjunger den kända artisten Erik Palm.\n• Danskursen med ledaren Luka Felin börjar kl. 17:00.\n• Matförsäljning och food trucks finns samlade i Västra parken.\n• Fototävling: Den person som har tagit den bästa bilden vinner ett presentkort på 500 kr.\n• Kostnad: Det är helt gratis att gå på festivalen!"
    }
  ],
  "questions": [
    {
      "id": "A_Q1",
      "type": "short",
      "prompt": "A. Vad heter personen som spelar och sjunger på Stora torget på kvällen?",
