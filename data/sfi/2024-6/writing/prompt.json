# Section B: Några personer berättar (Alla hjärtans dag)
$secB = @'
{
  "section": "B",
  "icon": "❤️",
  "title": "Några personer berättar om Alla hjärtans dag",
  "instructions": "I många länder firas Alla hjärtans dag den 14 februari. Här berättar några personer om de brukar fira dagen eller inte. Läs vad de säger och svara på frågorna.",
  "texts": [
    {
      "heading": "Miya",
      "body": "- Jag tycker inte att man måste ha en partner för att fira Alla hjärtans dag. Jag är singel, men jag har också rätt att fira. Så jag och mina vänner träffas den 14 februari varje år och ger presenter till varandra."
    },
    {
      "heading": "Valter",
      "body": "- När jag var ung firade nästan ingen Alla hjärtans dag. Det har blivit vanligt i Sverige först de senaste åren. Jag bryr mig inte om den dagen eftersom jag har levt ensam hela livet. Och om jag vill visa kärlek kan jag göra det en annan dag."
    },
    {
      "heading": "Anna",
      "body": "- Jag tycker egentligen att Alla hjärtans dag är en ganska konstig dag och inget att fira. Men några gånger har jag och min sambo ändå gjort det. Då har vi köpt något fint till varandra eller ätit på restaurang den dagen. Och vem vet, det kanske händer igen."
    },
    {
      "heading": "Klas",
      "body": "- Jag och min partner tycker om traditioner. Men Alla hjärtans dag är inget som vi tycker är viktigt. Kärlek är fantastiskt, men det kan man visa på andra sätt än att köpa blommor och choklad på en speciell dag. Så den dagen behövs inte helt enkelt."
    },
    {
      "heading": "Elsa",
      "body": "- Jag tycker att många affärer bara vill tjäna pengar på att sälja blommor och presenter på Alla hjärtans dag. Men ett par gånger har mina kompisar försökt att bjuda mig på middag för att fira dagen. Då har jag sagt att jag inte är intresserad för jag är helt emot den här dagen."
    }
  ],
  "questions": [
    {
      "id": "B_Q1",
      "type": "mcq",
      "prompt": "A. Brukar Miya fira Alla hjärtans dag?",
      "options": ["ja", "nej", "ibland"],
      "answer": "ja"
    },
    {
      "id": "B_Q2",
      "type": "mcq",
      "prompt": "B. Brukar Valter fira Alla hjärtans dag?",
      "options": ["ja", "nej", "ibland"],
      "answer": "nej"
    },
    {
      "id": "B_Q3",
      "type": "mcq",
      "prompt": "C. Brukar Anna fira Alla hjärtans dag?",
      "options": ["ja", "nej", "ibland"],
      "answer": "ibland"
    },
    {
      "id": "B_Q4",
      "type": "mcq",
      "prompt": "D. Brukar Klas fira Alla hjärtans dag?",
      "options": ["ja", "nej", "ibland"],
      "answer": "nej"
    },
    {
      "id": "B_Q5",
      "type": "mcq",
      "prompt": "E. Brukar Elsa fira Alla hjärtans dag?",
      "options": ["ja", "nej", "ibland"],
      "answer": "nej"
    }
  ]
}
'@
Set-Content -Path "$readingDir/B.json" -Value $secB -Encoding utf8

# Section C: En intervju med Ayana
$secC = @'
{
  "section": "C",
  "icon": "🍳",
  "title": "En intervju med Ayana",
  "instructions": "Läs frågorna och intervjun med Ayana som har varit med i TV och laga mat. Välj det svar (1–5) som passar bäst till varje fråga.",
  "texts": [
    {
      "heading": "Svarsalternativ",
      "body": "1. - Jag vill gärna skriva en egen kokbok i framtiden. Jag har redan börjat samla på recept och tagit bilder på rätter som jag har lagat.\n\n2. - Det kändes lite nervöst i början när kameran startade. Men efter fem minuter glömde jag bort att kameran fanns och det kändes precis som hemma i mitt eget kök.\n\n3. - Jag tittade på matprogram på TV varje kväll och provade nya recept hemma. Det är det bästa sättet att lära sig.\n\n4. - En av mina vänner anmälde mig utan att jag visste om det! När jag fick ett mejl från TV-bolaget blev jag först jätteförvånad, men sedan tackade jag ja.\n\n5. - Man måste ha tålamod och våga testa nya smaker. Det är inte farligt om maten misslyckas någon gång, man lär sig av sina misstag."
    }
  ],
  "questions": [
    {
      "id": "C_Q1",
      "type": "mcq",
      "prompt": "A. Hur blir man bra på att laga mat?",
      "options": ["1", "2", "3", "4", "5"],
      "answer": "5"
    },
    {
      "id": "C_Q2",
      "type": "mcq",
      "prompt": "B. Varför ville du vara med i TV och laga mat?",
      "options": ["1", "2", "3", "4", "5"],
      "answer": "4"
    },
    {
      "id": "C_Q3",
      "type": "mcq",
      "prompt": "C. Hur kändes det att laga mat i TV?",
      "options": ["1", "2", "3", "4", "5"],
      "answer": "2"
    },
    {
      "id": "C_Q4",
      "type": "mcq",
      "prompt": "D. Vad vill du göra i framtiden?",
      "options": ["1", "2", "3", "4", "5"],
      "answer": "1"
    }
  ]
}
'@
Set-Content -Path "$readingDir/C.json" -Value $secC -Encoding utf8

# Section D: En dagbok (David)
$secD = @'
{
  "section": "D",
  "icon": "📔",
  "title": "En dagbok (David)",
  "instructions": "David skriver lite om sitt liv i en dagbok. Läs texterna och välj det ord som passar bäst i varje lucka.",
  "texts": [
    {
      "heading": "onsdag 20 april",
      "body": "Jag har sökt jobb på en restaurang. Idag ringde chefen och sa att hon vill träffa mig imorgon. Jag har aldrig varit på en jobbintervju förut så jag är ganska nervös. Idag ska jag söka efter information på internet för jag vill [A] vilka frågor jag kan få på intervjun."
    },
    {
      "heading": "torsdag 21 april",
      "body": "Vilken dag! Nu har jag varit på intervjun och det kändes riktigt bra. Chefen var trevlig och det verkar vara ett roligt arbete. Jag vill gärna ha jobbet. Hoppas att hon [B] mig!"
    }
  ],
  "questions": [
    {
      "id": "D_Q1",
      "type": "mcq",
